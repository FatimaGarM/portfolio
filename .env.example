# Copia este archivo como .env.local y pon tus valores.
# .env.local no se sube a Git.

# Acceso al panel /admin: solo con tu cuenta de Google.
# El email que tiene permiso para entrar (tu Gmail).
ADMIN_EMAIL=tu-cuenta@gmail.com

# Las dos claves que te da Google Cloud al crear el cliente OAuth (tipo "Aplicación web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dirección de la web. En local: http://localhost:3000
# La URL de retorno que pongas en Google será APP_URL + /api/admin/login/callback
APP_URL=http://localhost:3000

# Firma de la cookie de sesión: una cadena aleatoria de 32 caracteres o más.
# Puedes generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
